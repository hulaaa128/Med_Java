ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
REDIS_PASSWORD=echomind123
LLM_FALLBACK_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=bge-m3
# 本地直接运行默认建议 never，并提前执行 ollama pull bge-m3；Docker Compose 可使用 when_missing。
OLLAMA_PULL_MODEL_STRATEGY=never
CHROMA_HOST=http://localhost
CHROMA_PORT=8002
CHROMA_COLLECTION=echomind_knowledge
RAG_VECTOR_ENABLED=true
RAG_RRF_K=60
RAG_SIMILARITY_THRESHOLD=0.0
MEMORY_KEEP_RECENT=5
MEMORY_EPISODIC_TOP_K=5
MEMORY_EPISODIC_SIMILARITY_THRESHOLD=0.5
MEMORY_EPISODIC_COLLECTION=echomind_episodic
MEMORY_PROFILE_COLLECTION=echomind_user_profile
# 默认使用 Anthropic；切换 DeepSeek 时改成 deepseek。
SPRING_PROFILES_ACTIVE=anthropic
